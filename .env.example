# Optional. Off by default. Fetches only api.osv.dev and api.github.com.
BASANOS_THREAT_INTEL=0
BASANOS_THREAT_INTEL_PROD=0
# Comma-separated owner/repo list for GitHub security advisories.
# BASANOS_INTEL_GITHUB_REPOS=OpenZeppelin/openzeppelin-contracts,alexar76/acex

# Persistent Ed25519 identity. The Docker image overrides this to /data/provider.key.
AIMARKET_PROVIDER_IDENTITY_FILE=.aimarket/provider.key
BASANOS_DATA_DIR=data
# Override the monorepo root when scanning contracts outside a checkout.
# BASANOS_CONTRACT_ROOT=
